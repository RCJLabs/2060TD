{
  "name": "2060td",
  "private": true,
  "version": "1.60.0",
  "description": "2060TD — hybrid tower defense / base builder set in a modern alternate-history war",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "screenshot": "node scripts/screenshot.mjs",
    "balance": "tsx src/tools/balance.ts",
    "build:single": "vite build --outDir dist-single --emptyOutDir && node scripts/single-file.mjs",
    "sheet": "node scripts/glyph-sheet.mjs",
    "zoom": "node scripts/zoom.mjs",
    "catch": "node scripts/catch.mjs",
    "icons": "node scripts/icons.mjs",
    "fit": "node scripts/fit.mjs",
    "e2e": "node scripts/e2e-all.mjs",
    "perf": "node scripts/perf.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^26.2.0",
    "eslint": "^9.15.0",
    "playwright": "^1.49.0",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
